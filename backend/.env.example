# Copia este archivo como backend/.env y ajusta los valores.
# NUNCA subas el archivo .env al repositorio.

# Almacenamiento: por ahora solo "sqlite". "firebase" queda reservado para el futuro.
STORAGE_BACKEND=sqlite
# Ruta de la base de datos SQLite (por defecto backend/data/horarios.db)
# DATABASE_URL=sqlite:///./data/horarios.db

# Orígenes permitidos del frontend (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generador de horarios
SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_WORKERS=8

# Reconocimiento de fotografías (opcional). Si se dejan vacías, la app funciona
# con el proveedor de demostración y con captura manual.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-opus-5
MAX_UPLOAD_MB=12
